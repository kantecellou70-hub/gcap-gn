# ═══════════════════════════════════════════════════════════
# GCAP-GN — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles.
# ⚠️ Ne JAMAIS commiter .env.local — il est dans .gitignore
# ═══════════════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────────────────────────────
# Trouver dans : Supabase Dashboard → Votre projet → Settings → API

# URL du projet Supabase  [OBLIGATOIRE — tous les envs]
# Format : https://<ref>.supabase.co
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anon publique Supabase  [OBLIGATOIRE — tous les envs]
# ⚠️ Cette clé est publique (frontend) — RLS Supabase protège les données
VITE_SUPABASE_ANON_KEY=votre-cle-anon-ici

# ─── Application ──────────────────────────────────────────────────────────────

# Nom affiché de l'application  [optionnel — défaut : GCAP-GN]
VITE_APP_NAME=GCAP-GN

# Version de l'application  [optionnel — défaut : 1.0.0]
# Doit correspondre à la version dans package.json
VITE_APP_VERSION=1.0.0

# Environnement d'exécution  [OBLIGATOIRE]
# Valeurs : development | staging | production
VITE_APP_ENV=development

# ─── Multi-tenant ─────────────────────────────────────────────────────────────

# Code du tenant par défaut  [OBLIGATOIRE]
# Slug du ministère connecté (ex : mefb, msante, meducation)
# Utilisé pour les redirections après login si le tenant n'est pas détecté
VITE_DEFAULT_TENANT=mefb

# ─── Intégrations externes ────────────────────────────────────────────────────

# URL de l'API SICOM (Système d'Information Comptabilité des Matières — MEFB)  [optionnel]
# Laisser vide pour activer le mode simulation (données de démo)
# En production : https://sicom.mefb.gov.gn/api/v1 (à confirmer avec MEFB)
VITE_SICOM_URL=

# ─── Edge Functions (configurer dans Supabase Dashboard > Edge Functions > Secrets) ──

# Clé API Resend pour les emails transactionnels urgents  [optionnel]
# Créer un compte sur https://resend.com → API Keys → Create
RESEND_API_KEY=

# DSN Sentry pour le monitoring des erreurs  [optionnel]
# Trouver dans : Sentry Dashboard → Votre projet → Settings → Client Keys
# Laisser vide pour désactiver le monitoring Sentry
VITE_SENTRY_DSN=

# ─── Audit — signature cryptographique ───────────────────────────────────────

# Clé secrète HMAC-SHA256 pour signer les entrées du journal d'audit  [OBLIGATOIRE en production]
# Générer avec : openssl rand -hex 32
# ⚠️ En l'absence de cette clé, les signatures seront vides (warning console au démarrage)
VITE_AUDIT_HMAC_SECRET=









































# ─── Playwright — tests E2E ───────────────────────────────────────────────────
# ⚠️ Ces comptes NE DOIVENT PAS exister en production
# Utiliser une base Supabase de TEST séparée (SUPABASE_TEST_URL)
# Voir e2e/fixtures/seed-test-data.ts pour créer ces comptes automatiquement

# URL de base pour les tests E2E  [défaut : http://localhost:5173]
PLAYWRIGHT_BASE_URL=http://localhost:5173

# UUID du tenant de test (généré par seed-test-data.ts)
PLAYWRIGHT_TEST_TENANT_ID=

# Exercice et ligne budgétaire pour les tests de charge
PLAYWRIGHT_TEST_EXERCICE_ID=
PLAYWRIGHT_TEST_LIGNE_ID=

# Compte test — rôle DAFF
PLAYWRIGHT_DAFF_EMAIL=
PLAYWRIGHT_DAFF_PASSWORD=

# Compte test — rôle CF (Contrôleur Financier — MFA activé)
PLAYWRIGHT_CF_EMAIL=
PLAYWRIGHT_CF_PASSWORD=
PLAYWRIGHT_TOTP_SECRET_CF=

# Compte test — rôle ORDONNATEUR (MFA activé)
PLAYWRIGHT_ORDONNATEUR_EMAIL=
PLAYWRIGHT_ORDONNATEUR_PASSWORD=
PLAYWRIGHT_TOTP_SECRET_ORDONNATEUR=

# Compte test — rôle SAFF
PLAYWRIGHT_SAFF_EMAIL=
PLAYWRIGHT_SAFF_PASSWORD=

# Compte test — rôle AUDITEUR (lecture seule)
PLAYWRIGHT_AUDITEUR_EMAIL=
PLAYWRIGHT_AUDITEUR_PASSWORD=

# ─── Supabase TEST — seed E2E (jamais en production) ─────────────────────────
# Utiliser le Service Role Key (accès total) pour le seed uniquement
# JAMAIS exposer cette clé côté frontend ni la commiter
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
