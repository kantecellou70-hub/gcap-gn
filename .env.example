# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application
VITE_APP_NAME=GCAP-GN
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Tenant (remplacé dynamiquement selon le ministère connecté)
VITE_DEFAULT_TENANT=mefb

# Feature flags
VITE_ENABLE_SICOM_INTEGRATION=false
VITE_ENABLE_TRESOR_INTEGRATION=false
VITE_ENABLE_OFFLINE_MODE=false

# SICOM — laisser vide pour utiliser le mode simulation (données de démo)
VITE_SICOM_URL=
